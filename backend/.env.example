# FWRP Backend — example environment
# Copy to .env: cp .env.example .env

NODE_ENV=development
PORT=3001

# Supabase (Project Settings → Database → Connection string)
# Runtime: session pooler (port 5432) — measured ~5x lower latency than the
# transaction pooler for this app's interactive transactions. For serverless /
# many instances use the transaction pooler instead:
#   ...pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# URL-encode special characters in the password (e.g. @ → %40).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?connection_limit=5
# Migrations: session pooler (port 5432).
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Use long random strings outside development
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Production only — development/test always use the in-memory mock (see docs/email.md)
SMTP_HOST=
# SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@fwrp.local

# Matching radius in km (docs/matching.md)
MATCHING_MAX_DISTANCE_KM=50
# Re-score live matches every N minutes (0 disables)
MATCHING_REFRESH_INTERVAL_MINUTES=15
# Time-based alerts + notification email outbox every N minutes (0 disables)
NOTIFICATION_JOB_INTERVAL_MINUTES=1

# Auth rate limiting (on by default outside tests); proxy hops in front of the API
RATE_LIMIT_ENABLED=true
TRUST_PROXY_HOPS=0
# Password reset links point at the frontend
APP_BASE_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=30
# Expire past-window donations and past-deadline requirements every N minutes (0 disables)
EXPIRY_JOB_INTERVAL_MINUTES=1
